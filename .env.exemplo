# Modelo do .env.local — copie para `.env.local` e preencha. Nunca commite valores reais.
# Os valores reais ficam com o dono do projeto (gerenciador de senhas); os de produção/staging ficam só na VPS.

# --- Banco (Postgres) ---
# Desenvolvimento local: use o papel `crm_app` (sujeito ao RLS), nunca o admin. As migrations rodam como `crm_migrator`.
DATABASE_URL="postgres://crm_app:SENHA@127.0.0.1:5440/NOME_DO_BANCO"

# --- App ---
NEXT_PUBLIC_APP_URL="http://localhost:3000"
# Segredo que assina os links de anexos (qualquer texto longo e aleatório; em dev pode ser novo).
ANEXOS_SEGREDO=""

# --- WhatsApp (Evolution). CUIDADO: a instância é compartilhada; só o webhook de UM ambiente funciona por vez. ---
EVOLUTION_API_URL=""
EVOLUTION_API_KEY=""

# --- Legado (só para ETL/consulta; o CRM novo não depende disso) ---
NEXT_PUBLIC_SUPABASE_URL=""
NEXT_PUBLIC_SUPABASE_ANON_KEY=""
SUPABASE_SERVICE_ROLE_KEY=""
SUPABASE_LP_URL=""
SUPABASE_LP_ANON_KEY=""

# --- Google Sheets (espelho/ETL) ---
GOOGLE_CLIENT_EMAIL=""
GOOGLE_PRIVATE_KEY=""
GOOGLE_SHEET_ID=""
GOOGLE_SHEET_ID_1=""
GOOGLE_SHEET_ID_2=""
GOOGLE_SHEET_ID_3=""
